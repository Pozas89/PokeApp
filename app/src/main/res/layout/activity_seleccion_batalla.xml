<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- CABECERA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRegresarBatalla"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Regresar"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SIMULADOR DE BATALLA"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="ELIGE A LOS COMBATIENTES"
            android:textColor="#70E39A"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- POKÉMON 1 -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/pokedex_data_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POKÉMON 1"
                android:textColor="#70E39A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPokemon1"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="Nombre o ID"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#90A4AE" />

                <Button
                    android:id="@+id/btnBuscarPokemon1"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:text="BUSCAR" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progresoPokemon1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgPokemon1"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:contentDescription="Pokémon 1"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvNombrePokemon1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="---"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTipoPokemon1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="---"
                android:textColor="#70E39A"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatsPokemon1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="HP --   •   ATK --&#10;DEF --   •   SPD --"
                android:textColor="#CFD8DC"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- VS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:gravity="center"
            android:text="VS"
            android:textColor="#FF5252"
            android:textSize="30sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- POKÉMON 2 -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pokedex_data_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POKÉMON 2"
                android:textColor="#70E39A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPokemon2"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="Nombre o ID"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#90A4AE" />

                <Button
                    android:id="@+id/btnBuscarPokemon2"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:text="BUSCAR" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progresoPokemon2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgPokemon2"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:contentDescription="Pokémon 2"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvNombrePokemon2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="---"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTipoPokemon2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="---"
                android:textColor="#70E39A"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatsPokemon2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="HP --   •   ATK --&#10;DEF --   •   SPD --"
                android:textColor="#CFD8DC"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- INICIAR -->

        <Button
            android:id="@+id/btnIniciarBatalla"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="30dp"
            android:text="⚔  INICIAR BATALLA"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>