<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollBatalla"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================================================= -->
        <!-- CABECERA -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnRegresarBatalla"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Regresar"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="BATALLA POKÉMON"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTurno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TURNO 0"
                android:textColor="#70E39A"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ESCENARIO -->
        <!-- ================================================= -->

        <FrameLayout
            android:id="@+id/escenarioBatalla"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/fondo_batalla_campo">


            <!-- ================================================= -->
            <!-- CPU - INFORMACIÓN -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardCpu"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="14dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_hp_batalla"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNombreCpu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="POKÉMON CPU"
                        android:textColor="#17252C"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPU"
                        android:textColor="#C62828"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HP"
                        android:textColor="#17252C"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/barHpCpu"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/barra_hp_verde" />

                </LinearLayout>


                <TextView
                    android:id="@+id/tvHpCpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="-- / -- HP   100%"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- IMAGEN CPU -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/imgPokemonCpu"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="90dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="Pokémon rival"
                android:scaleType="fitCenter" />


            <!-- ================================================= -->
            <!-- JUGADOR - IMAGEN -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/imgPokemonJugador"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="0dp"
                android:layout_marginBottom="20dp"
                android:contentDescription="Pokémon del jugador"
                android:scaleType="fitCenter" />


            <!-- ================================================= -->
            <!-- JUGADOR - INFORMACIÓN -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardJugador"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/card_hp_batalla"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNombreJugador"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="POKÉMON"
                        android:textColor="#17252C"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TÚ"
                        android:textColor="#1565C0"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HP"
                        android:textColor="#17252C"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/barHpJugador"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/barra_hp_verde" />

                </LinearLayout>


                <TextView
                    android:id="@+id/tvHpJugador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="-- / -- HP   100%"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>


        <!-- ================================================= -->
        <!-- MENSAJE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvMensajeBatalla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/card_mensaje_batalla"
            android:gravity="center"
            android:minHeight="55dp"
            android:padding="10dp"
            android:text="Preparando batalla..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- INICIAR -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnComenzarCombate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:text="⚔  INICIAR BATALLA"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- ATAQUES -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/panelAtaques"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/pokedex_data_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPreguntaAtaque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="¿QUÉ HARÁ TU POKÉMON?"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- FILA 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAtaque1"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:text="ATAQUE 1"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnAtaque2"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:text="ATAQUE 2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- FILA 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAtaque3"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:text="ATAQUE 3"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnAtaque4"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:text="ATAQUE 4"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- REGISTRO -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/pokedex_data_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REGISTRO DE BATALLA"
                android:textColor="#70E39A"
                android:textSize="15sp"
                android:textStyle="bold" />


            <ScrollView
                android:id="@+id/scrollRegistro"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/pokedex_data_panel"
                android:padding="12dp"
                android:fillViewport="true"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:overScrollMode="always">

                <TextView
                    android:id="@+id/tvRegistroBatalla"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="El registro de batalla aparecerá aquí."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:padding="8dp" />

            </ScrollView>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- RESULTADO -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/panelResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/card_resultado_batalla"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🏆 RESULTADO 🏆"
                android:textColor="#FFD54F"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgGanador"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="5dp"
                android:contentDescription="Ganador"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvGanador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="GANADOR"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultadoDetalles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="HP restante: --&#10;Turnos: --"
                android:textColor="#CFD8DC"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnRevancha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="REVANCHA"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnElegirOtros"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:text="ELEGIR OTROS POKÉMON"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVolverMenu"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:text="VOLVER AL MENÚ"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>